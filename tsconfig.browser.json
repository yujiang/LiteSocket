{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2021", "DOM"],
    "types": [],
    "paths": {
      "ws": ["./src/browser/ws.ts"],
      "node:timers/promises": ["./src/browser/timers.ts"],
      "node:assert": ["./src/browser/assert.ts"],
      "assert": ["./src/browser/assert.ts"],
    },
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true
  },
  "include": ["src/client.ts", "src/browser/**/*.ts"],
  "exclude": ["node_modules", "lib"]
}
