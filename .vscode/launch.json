{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "sourceMaps": true,
      "name": "调试当前示例文件",
      "program": "${workspaceFolder}/.example-build/${relativeFileDirname}/${fileBasenameNoExtension}.js",
      "preLaunchTask": "build examples",
      "outFiles": [
        "${workspaceFolder}/.example-build/**/*.js"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "sourceMaps": true,
      "name": "调试当前测试文件",
      "program": "${workspaceFolder}/.test-build/${relativeFileDirname}/${fileBasenameNoExtension}.js",
      "runtimeArgs": [
        "--test"
      ],
      "preLaunchTask": "build tests",
      "outFiles": [
        "${workspaceFolder}/.test-build/**/*.js"
      ],
      "autoAttachChildProcesses": true
    },
    {
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "sourceMaps": true,
      "name": "调试当前 JavaScript 文件",
      "program": "${file}",
      "outFiles": [
        "${workspaceFolder}/bin-debug/**/*.js",
        "${workspaceFolder}/.example-build/**/*.js",
        "${workspaceFolder}/.test-build/**/*.js"
      ]
    },
    {
      "name": "调试 lib 示例",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "program": "${workspaceFolder}/.example-build/example/lib/example_lib_full.js",
      "preLaunchTask": "build lib examples",
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "outFiles": [
        "${workspaceFolder}/.example-build/**/*.js",
        "${workspaceFolder}/lib/full/**/*.js"
      ]
    }
  ]
}
