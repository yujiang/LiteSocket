{
  "name": "@mosnpm/litesocket",
  "version": "0.1.3",
  "description": "Lightweight WebSocket client and server with RPC support",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "main": "./lib/full/index.js",
  "scripts": {
    "test": "pnpm test:build && node --test --test-concurrency=1 .test-build/test/*/test_*.js",
    "test:build": "node -e \"require('node:fs').rmSync('.test-build', { recursive: true, force: true })\" && tsc -p tsconfig.test.json",
    "test:types": "tsc -p tsconfig.test.json --noEmit",
    "example:build": "tsc -p tsconfig.example.json",
    "example": "pnpm example:build && node .example-build/example/example_lite_msg.js",
    "example:lib:build": "node scripts/build-lib-examples.cjs",
    "example:lib": "pnpm example:lib:build && node .example-build/example/lib/example_lib_full.js",
    "build": "node scripts/build.cjs",
    "prepack": "pnpm build",
    "build:full": "node scripts/build.cjs full",
    "build:client": "node scripts/build.cjs client",
    "test:lib": "pnpm build && node --test test/build/*.cjs"
  },
  "dependencies": {
    "chalk": "4",
    "tslib": "^2.8.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/ws": "^8.18.1",
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.22.0",
  "types": "./lib/full/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/full/index.d.ts",
      "require": "./lib/full/index.js",
      "default": "./lib/full/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "import": "./lib/client/index.js",
      "default": "./lib/client/index.js"
    },
    "./client/global": "./lib/client/litesocket.global.js"
  },
  "files": [
    "lib",
    "readme_cn.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yujiang/LiteSocket.git"
  }
}
